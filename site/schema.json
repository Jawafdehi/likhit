{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jawafdehi.github.io/likhit/data/schema.json",
  "title": "Likhit benchmark artifact",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "build",
    "integration",
    "summary",
    "configurations",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "build": {
      "type": "object",
      "required": [
        "commit",
        "ref",
        "python",
        "likhit",
        "markitdown"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "measured": {
      "description": "Provenance of the measurements, when they were replayed from a recorded snapshot rather than taken by this build. Null on a build that ran the conversions itself. Optional rather than required so that artifacts published before this field existed still validate against schema_version 1; the generator always emits it.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "recorded_at",
        "build",
        "missing_runs",
        "stale"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "build": {
          "description": "Commit and tool versions the recorded runs were measured against.",
          "type": "object",
          "required": [
            "commit",
            "ref",
            "python",
            "likhit",
            "markitdown"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "missing_runs": {
          "description": "Catalog runs the snapshot does not cover, and which were therefore skipped.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale": {
          "description": "Whether the recorded commit differs from the commit that published this build. Informational: committing a recording necessarily creates a commit later than the one it was recorded on, so this is true on effectively every deploy and is reported rather than warned about.",
          "type": "boolean"
        }
      }
    },
    "integration": {
      "type": "object",
      "required": [
        "status",
        "tests",
        "failures",
        "errors",
        "skipped",
        "duration_s",
        "cases"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "cases": {
          "type": "array"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "documents",
        "runs",
        "pass",
        "fail",
        "known_issue",
        "blocked",
        "reference"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "configurations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "available"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "model": {
            "description": "Vision model this configuration was recorded against, or null for a configuration that uses no OCR. Held per configuration rather than per run so it is reportable for the runs that made no vision call -- which is most of them.",
            "type": [
              "string",
              "null"
            ]
          },
          "unavailable_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "kind",
        "publisher",
        "origin",
        "privacy",
        "content_note",
        "tags",
        "source",
        "runs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "pdf",
            "docx",
            "doc"
          ]
        },
        "publisher": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "synthetic",
            "public-institutional"
          ]
        },
        "privacy": {
          "enum": [
            "synthetic-pii-free",
            "public-institutional"
          ]
        },
        "content_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "required": [
            "download",
            "bytes",
            "sha256",
            "pages"
          ],
          "properties": {
            "download": {
              "type": "string"
            },
            "original_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "original_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "sanitization": {
              "type": [
                "string",
                "null"
              ]
            },
            "thumbnail": {
              "type": [
                "string",
                "null"
              ]
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "pages": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "config",
        "label",
        "outcome",
        "status",
        "wall_s",
        "max_rss_mb",
        "metrics",
        "checks",
        "transcript",
        "transcript_sha256",
        "diagnostics",
        "diagnostics_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "known-issue",
            "blocked",
            "reference"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "timeout",
            "bad-output"
          ]
        },
        "pages": {
          "type": [
            "string",
            "null"
          ]
        },
        "wall_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_rss_mb": {
          "type": [
            "number",
            "null"
          ]
        },
        "metrics": {
          "type": "object"
        },
        "checks": {
          "type": "array"
        },
        "transcript": {
          "type": "string"
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diagnostics": {
          "type": "string"
        },
        "diagnostics_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ocr_usage": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "calls",
            "input_tokens",
            "output_tokens",
            "total_tokens",
            "model"
          ],
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
