    {
      "id": "legacy-then-english",
      "title": "Legacy Nepali followed by English",
      "summary": "A two-page file used to verify that page-scoped extraction does not leak font classification.",
      "kind": "pdf",
      "builder": "legacy_then_english",
      "publisher": "Likhit benchmark lab",
      "origin": "synthetic",
      "privacy": "synthetic-pii-free",
      "tags": ["page-range", "legacy-font", "english"],
      "runs": [
        {
          "id": "likhit-full",
          "config": "likhit",
          "expectation": "known_issue",
          "checks": [
            {
              "kind": "contains",
              "value": "Ordinary English catalogue",
              "label": "English page retained"
            },
            {
              "kind": "min_devanagari",
              "value": 20,
              "label": "Legacy page decoded"
            }
          ]
        },
        {
          "id": "likhit-page-2",
          "config": "likhit",
          "pages": "2",
          "expectation": "pass",
          "checks": [
            {
              "kind": "contains",
              "value": "Ordinary English catalogue",
              "label": "Requested page returned"
            },
            {
              "kind": "max_devanagari",
              "value": 0,
              "label": "Page-one font state did not leak"
            }
          ]
        }
      ]
    },
